# Same Neon database as the Scraper. drizzle-kit only auto-loads .env (not .env.local).
DATABASE_URL=postgres://user:password@host.neon.tech/db?sslmode=require
# Disposable branch only; integration tests skip when unset and refuse DATABASE_URL equality.
TEST_DATABASE_URL=
# 32+ random characters. Not the Scraper's JWT_SECRET: the two logins stay separate.
SESSION_SECRET=
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Rotate by re-encrypting.
ACCOUNT_NO_KEY=
# Seeded by `npm run db:seed` when directory_users is empty.
DIRECTORY_ADMIN_EMAIL=
DIRECTORY_ADMIN_PASSWORD=
