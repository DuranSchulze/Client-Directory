# Postgres in the Scraper Docker stack, published on host port 5434.
DATABASE_URL=postgresql://user:password@127.0.0.1:5434/client_directory
CONTAINER_DATABASE_URL=postgresql://user:password@host.docker.internal:5434/client_directory
# Separate local database for tests. Integration tests skip if this is unset.
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5434/client_directory_test
# 32+ random characters. Not the Scraper's JWT_SECRET: the two logins stay separate.
SESSION_SECRET=
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Rotate by re-encrypting.
ACCOUNT_NO_KEY=
# Seeded by `npm run db:seed` when directory_users is empty.
DIRECTORY_ADMIN_EMAIL=
DIRECTORY_ADMIN_PASSWORD=
